{
  "name": "vaga-viva-clinic",
  "version": "0.0.0",
  "private": true,
  "description": "API de um sistema fictício de agendamento de clínica (modelo typescript-node do Vaga Viva)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.22.0"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "pretest": "prisma generate",
    "test": "node --experimental-vm-modules --no-warnings=ExperimentalWarning node_modules/jest/bin/jest.js"
  },
  "dependencies": {
    "@nestjs/common": "12.4.0",
    "@nestjs/config": "12.1.1",
    "@nestjs/core": "12.4.0",
    "@nestjs/platform-express": "12.4.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "luxon": "3.7.2",
    "pg": "8.23.1",
    "prisma": "7.10.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "12.4.0",
    "@testcontainers/postgresql": "12.2.1",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/jest-expect-message": "1.1.0",
    "@types/luxon": "3.7.6",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "jest": "30.5.2",
    "jest-expect-message": "1.1.3",
    "jest-junit": "17.0.0",
    "supertest": "7.3.2",
    "testcontainers": "12.2.1",
    "ts-jest": "29.4.15",
    "typescript": "6.0.3",
    "yaml": "2.9.1"
  }
}
